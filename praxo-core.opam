opam-version: "2.0"
synopsis: "Embeddable MIT-licensed agent framework for OCaml"
description: """
Native OCaml Core for PRAXO-CORE: JSON, tool calls, JSON Schema subset,
plugin manifests, policy hooks, memory, checkpoints, context compaction,
middleware, events, and an agent loop. No Go runtime or provider adapter is
required.
"""
maintainer: "AxisVela <releases@axisvela.com>"
authors: "AxisVela"
license: "MIT"
homepage: "https://axisvela.github.io/praxo-core/"
bug-reports: "https://github.com/axisvela/praxo-core-ocaml/issues"
dev-repo: "git+https://github.com/axisvela/praxo-core-ocaml.git"
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
]
